{
  "manifest_version": 3,
  "name": "Transcribe + X Bookmarks Archive",
  "version": "0.4.0",
  "description": "Transcribe videos on x.com and youtube.com (MP3 or text via Groq Whisper). Export your X bookmarks to an Obsidian/Notion-ready folder of Markdown files with YAML frontmatter, thread continuations, top-20 comments, conversation parents, and a CSV index. Auto-syncs new bookmarks.",
  "permissions": ["identity", "storage", "downloads", "activeTab"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.youtube.com/*",
    "https://*.ngrok-free.app/*",
    "https://*.ngrok.app/*",
    "https://*.ngrok.io/*",
    "https://*.ngrok.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["bookmarks.js"],
      "css": ["bookmarks.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Transcribe",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
