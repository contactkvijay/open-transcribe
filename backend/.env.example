# Copy to .env and fill in. Never commit .env.

# --- Google OAuth (Web Application client) ---
# Created at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# --- Groq API ---
# Created at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# --- Our session JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_DAYS=30

# --- Storage ---
# Defaults are next to backend/ source files. Override only if you want them elsewhere.
# DB_PATH=./transcribe.db
# TMP_AUDIO_DIR=./tmp_audio
AUDIO_URL_TTL_SECONDS=3600
AUDIO_RETENTION_HOURS=24

# --- HTTP ---
# Comma-separated origins. chrome-extension://* is the wildcard for extensions.
ALLOWED_ORIGINS=chrome-extension://*
HOST=0.0.0.0
PORT=8765
